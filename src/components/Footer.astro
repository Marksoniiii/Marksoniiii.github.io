---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";
import { getRelativeLocaleUrl } from "astro:i18n";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
const locale = Astro.currentLocale ?? config.site.lang;
---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div
    class="border-border text-muted-foreground flex flex-col items-center justify-between border-t py-8 text-sm sm:flex-row-reverse sm:py-7"
  >
    <div class="flex items-center gap-3">
      <a
        href={getRelativeLocaleUrl(locale, "subscribe")}
        class="hover:text-accent font-mono text-xs tracking-wider uppercase"
      >
        订阅更新
      </a>
      <Socials />
    </div>
    <div class="my-2 flex flex-col items-center whitespace-nowrap sm:flex-row">
      <span class="font-mono"
        >© {currentYear} MARKSON / BUILT WITH CURIOSITY</span
      >
    </div>
  </div>
</footer>
